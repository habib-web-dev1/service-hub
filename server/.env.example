DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/servicehub_db"

PORT=5000

NODE_ENV="development"

JWT_SECRET="your-development-access-secret"

# Reserved for future refresh-token implementation (optional for now)
JWT_REFRESH_SECRET="your-development-refresh-secret"

# Allowed CORS origin — set to your frontend URL
CORS_ORIGIN="http://localhost:3000"
